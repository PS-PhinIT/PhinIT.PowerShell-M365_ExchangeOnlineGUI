                                x:Name="helpLinkRegionSettings"
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Foreground="#0067c0"
                                Text="Hilfe zu Regionaleinstellungen"
                                TextDecorations="Underline" />

                            <!--  Linke Spalte - Verwaltung  -->
