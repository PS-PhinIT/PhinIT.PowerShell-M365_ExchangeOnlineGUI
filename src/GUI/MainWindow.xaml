                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Linke Spalte  -->
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <GroupBox
