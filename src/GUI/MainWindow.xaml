                                                                ToolTip="Aktiviert den Versionsspeicher für Kalenderelemente, um die Wiederherstellung von Änderungen zu erleichtern." />
                                                            <CheckBox
                                                                x:Name="chkEcRequiresTls"
                                                                Margin="0,5"
