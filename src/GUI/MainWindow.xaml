<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="easyEXO | Exchange Online Management Tool"
    Width="1700"
    Height="1000"
    MinWidth="950"
    MinHeight="650"
    Background="#F5F7FA"
    FontFamily="Segoe UI"
    FontSize="12"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--  Styles und Farben: src/GUI/Theme.xaml (wird beim Laden hier eingefügt)  -->
        <!-- @THEME@ -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!--  Header mit modernem Design  -->
        <Border
            Grid.Row="0"
            Background="#0F1B2D"
            BorderBrush="#E0E0E0"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Linker Bereich mit Logo/Icon  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Foreground="#e2e2e2"
                        Text="🔄" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#E6EDF3"
                            Text="PSscripts.de  |  easyIT - Exchange Online" />
                        <TextBlock
                            x:Name="txtVersion"
                            FontSize="11"
                            Foreground="#9FB3C8"
                            Text="" />
                    </StackPanel>
                </StackPanel>

                <!--  Mittlerer Bereich - Status  -->
                <Border
                    x:Name="headerStatusContainer"
                    Grid.Column="1"
                    Margin="20,12,20,12"
                    Background="#0078D7"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <Grid Margin="10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="White"
                            Text="🔔" />
                        <TextBlock
                            x:Name="headerStatus"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="Status-Nachricht"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <!--  Rechter Bereich mit Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    Height="52"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Style="{StaticResource HeaderIconButton}"
                        x:Name="btnSettings"
                        Width="48"
                        Height="48"
                        Margin="5,0"
                        ToolTip="Einstellungen">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Text="⚙" />
                    </Button>
                    <Button
                        Style="{StaticResource HeaderIconButton}"
                        x:Name="btnInfo"
                        Width="48"
                        Height="48"
                        Margin="5,0"
                        ToolTip="Info">
                        <Grid>
                            <Ellipse
                                Width="20"
                                Height="20"
                                Fill="#e2e2e2" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#0F1B2D"
                                Text="i" />
                        </Grid>
                    </Button>
                    <Button
                        Style="{StaticResource HeaderIconButton}"
                        x:Name="btnClose"
                        Width="48"
                        Height="48"
                        Margin="5,0"
                        ToolTip="Schließen">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#FF5252"
                            Text="✕" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main Content mit moderner Navigation  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Navigation Panel mit modernem Design  -->
            <Border
                Grid.Column="0"
                Background="#16253A"
                BorderBrush="#0F1B2D"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10">
                    <Button
                        Style="{StaticResource ConnectButton}"
                        x:Name="btnConnect"
                        Height="38"
                        Margin="8,5,8,10"
                        Content="Mit Exchange verbinden" />

                    <GroupBox
                        Margin="8,0,8,25"
                        Padding="8"
                        Background="#22344D"
                        BorderBrush="#2F4560"
                        BorderThickness="1"
                        Foreground="#E6EDF3"
                        Header="Verbindungsstatus">
                        <StackPanel>
                            <TextBlock
                                x:Name="txtConnectionStatus"
                                Margin="8,0,8,0"
                                FontWeight="SemiBold"
                                Foreground="#E6EDF3"
                                Text="Nicht verbunden" />
                        </StackPanel>
                    </GroupBox>
                    <!--  Navigation Header  -->

                    <Button
                        Style="{StaticResource NavButton}"
                        x:Name="btnDashboard"
                        Content="Dashboard"/>

                    <!--  Grundlegende Verwaltung  -->
                    <Expander
                        Style="{StaticResource NavExpander}"
                        Header="Management"
                        IsExpanded="True">
                        <StackPanel>
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavMailbox"
                                Content="Mailbox Permissions" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavCalendar"
                                Content="Calendar Permissions" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavSharedMailbox"
                                Content="Shared Mailboxes" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavGroups"
                                Content="Groups / Distribution Lists" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavResources"
                                Content="Resources" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavContacts"
                                Content="Contacts" />
                        </StackPanel>
                    </Expander>


                    <!--  Mail Flow  -->
                    <Expander
                        Style="{StaticResource NavExpander}"
                        Header="Mail-Flow"
                        IsExpanded="False">
                        <StackPanel>
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavMailFlowRules"
                                Content="Transport Rules" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavInboxRules"
                                Content="Inbox Rules" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavMessageTrace"
                                Content="Message Trace" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavAutoReply"
                                Content="Auto Reply" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavCrossPremises"
                                Content="Cross-Premises Routing" />
                            <!-- <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavHybridExchange"
                                Content="Hybrid Exchange Config" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavMultiForest"
                                Content="Multi-Forest Management" /> -->
                        </StackPanel>
                    </Expander>


                    <!--  Systemkonfiguration  -->
                    <Expander
                        Style="{StaticResource NavExpander}"
                        Header="Konfiguration"
                        IsExpanded="False">
                        <StackPanel>
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavEXOSettings"
                                Content="Exchange Online" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavRegion"
                                Content="Language / Time Zone" />
                        </StackPanel>
                    </Expander>

                    <!--  Sicherheit & Compliance  -->
                    <Expander
                        Style="{StaticResource NavExpander}"
                        Header="Sicherheit &amp; Compliance"
                        IsExpanded="False">
                        <StackPanel>
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavATP"
                                Content="Advanced Threat Protection" />
                            <!--     <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavDLP"
                                Content="Data Loss Prevention" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavEDiscovery"
                                Content="eDiscovery &amp; Legal Hold" /> -->
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavMDM"
                                Content="Mobile Device Management" />
                        </StackPanel>
                    </Expander>

                    <!--  Monitoring & Support  -->
                    <Expander
                        Style="{StaticResource NavExpander}"
                        Header="Monitoring &amp; Support"
                        IsExpanded="False">
                        <StackPanel>
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavHealthCheck"
                                Content="Health Check" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavAudit"
                                Content="Audit" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavReports"
                                Content="Reports" />
                            <Button
                                Style="{StaticResource NavButton}"
                                x:Name="btnNavTroubleshooting"
                                Content="Troubleshooting" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!--  Content Tabs mit modernem Design  -->
            <Border
                Grid.Column="1"
                Padding="20"
                Background="#FFFFFF">
                <TabControl
                    x:Name="tabContent"
                    Background="Transparent"
                    BorderThickness="0">
                    <TabItem
                        x:Name="tabCalendar"
                        Header="Kalenderberechtigungen"
                        Visibility="Collapsed">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Hilfe Link  -->
                            <TextBlock
                                x:Name="helpLinkCalendar"
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Foreground="#0067c0"
                                Text="Hilfe zu Kalenderberechtigungen"
                                TextDecorations="Underline" />

                            <!--  Linke Spalte - Verwaltung  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                                <!--  Berechtigung hinzufügen/entfernen  -->
                                <GroupBox
                                    Margin="0,0,0,10"
                                    Background="#ffffff"
                                    Header="Berechtigungen verwalten">
                                    <StackPanel Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Kalender-Besitzer:" />
                                            <TextBox
                                                x:Name="txtCalendarSource"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,5" />

                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Ziel-Benutzer:" />
                                            <TextBox
                                                x:Name="txtCalendarTarget"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,5" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Berechtigungsstufe:" />
                                            <ComboBox
                                                x:Name="cmbCalendarPermission"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,10" />

                                            <StackPanel
                                                Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource SuccessButton}"
                                                    x:Name="btnAddCalendarPermission"
                                                    Width="180"
                                                    Height="30"
                                                    Margin="0,0,10,0"
                                                    Content="Hinzufügen" />
                                                <Button
                                                    Style="{StaticResource DangerButton}"
                                                    x:Name="btnRemoveCalendarPermission"
                                                    Width="180"
                                                    Height="30"
                                                    Content="Entfernen" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!--  Standard-Berechtigungen  -->
                                <GroupBox
                                    Margin="0,0,0,10"
                                    Background="#ffffff"
                                    Header="Standardberechtigungen">
                                    <StackPanel Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Berechtigungsstufe:" />
                                            <ComboBox
                                                x:Name="cmbDefaultPermission"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,10" />

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource SecondaryButton}"
                                                    x:Name="btnSetDefaultPermission"
                                                    Width="110"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Content="Default setzen" />
                                                <Button
                                                    Style="{StaticResource SecondaryButton}"
                                                    x:Name="btnSetAnonymousPermission"
                                                    Width="120"
                                                    Height="30"
                                                    Margin="5,0,5,0"
                                                    Content="Anonym setzen" />
                                                <Button
                                                    Style="{StaticResource WarningButton}"
                                                    x:Name="btnSetAllCalPermission"
                                                    Width="120"
                                                    Height="30"
                                                    Margin="5,0,0,0"
                                                    Content="Alle Postfächer"
                                                    ToolTip="Setzt die ausgewählte Berechtigungsstufe für ALLE Postfächer (Default oder Anonym)." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <!--  Berechtigungen anzeigen  -->
                                <GroupBox Background="#ffffff" Header="Berechtigungen anzeigen">
                                    <StackPanel Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Postfach:" />
                                            <TextBox
                                                x:Name="txtCalendarMailboxUser"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,10" />

                                            <Button
                                                Style="{StaticResource SecondaryButton}"
                                                x:Name="btnShowCalendarPermissions"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Width="240"
                                                Height="30"
                                                Margin="130,5,0,10"
                                                HorizontalAlignment="Center"
                                                Content="Berechtigungen anzeigen" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!--  Rechte Spalte - Ausgaben  -->
                            <GroupBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Background="#ffffff"
                                Header="Aktuelle Berechtigungen für das angezeigte Postfach">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid
                                        x:Name="lstCalendarPermissions"
                                        Grid.Row="0"
                                        Margin="8,8,8,0"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="1.5*"
                                                Binding="{Binding User}"
                                                Header="Benutzer" />
                                            <DataGridTextColumn
                                                Width="2*"
                                                Binding="{Binding AccessRights}"
                                                Header="Berechtigungen" />
                                            <DataGridTextColumn
                                                Width="1*"
                                                Binding="{Binding IsInherited}"
                                                Header="Geerbt" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button
                                        Style="{StaticResource SecondaryButton}"
                                        x:Name="btnExportCalendarPermissions"
                                        Grid.Row="1"
                                        Width="180"
                                        Height="30"
                                        Margin="0,8,8,8"
                                        HorizontalAlignment="Right"
                                        Content="Liste exportieren (CSV)" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <!--  Mailbox Tab  -->
                    <TabItem
                        x:Name="tabMailbox"
                        Header="Postfachberechtigungen"
                        Visibility="Collapsed">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Hilfe Link  -->
                            <TextBlock
                                x:Name="helpLinkMailbox"
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right"
                                Cursor="Hand"
                                Foreground="#0067c0"
                                Text="Hilfe zu Postfachberechtigungen"
                                TextDecorations="Underline" />

                            <!--  Linke Spalte - Verwaltung  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,0">

                                <!--  Postfach und Benutzer auswählen  -->
                                <GroupBox
                                    Margin="0,0,0,10"
                                    Background="#ffffff"
                                    Header="Postfach und Benutzer auswählen">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="120"
                                            Margin="0,5,10,5"
                                            VerticalAlignment="Center"
                                            Text="Postfach:" />
                                        <TextBox
                                            x:Name="txtMailboxSource"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0,5,0,5"
                                            ToolTip="Das Postfach, dessen Berechtigungen verwaltet werden sollen." />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="120"
                                            Margin="0,5,10,5"
                                            VerticalAlignment="Center"
                                            Text="Ziel-Benutzer:" />
                                        <TextBox
                                            x:Name="txtMailboxTarget"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Height="30"
                                            Margin="0,5,0,5"
                                            ToolTip="Der Benutzer, der Berechtigungen erhalten oder verlieren soll." />
                                    </Grid>
                                </GroupBox>

                                <!--  Berechtigungen verwalten  -->
                                <GroupBox
                                    Margin="0,0,0,10"
                                    Background="#ffffff"
                                    Header="Berechtigungen verwalten">
                                    <StackPanel Margin="10">
                                        <!--  FullAccess Berechtigungen  -->
                                        <TextBlock FontWeight="SemiBold" Text="FullAccess:" />
                                        <StackPanel Margin="0,5,0,15" Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource SuccessButton}"
                                                x:Name="btnAddMailboxPermission"
                                                Width="180"
                                                Height="30"
                                                Margin="0,0,10,0"
                                                Content="Hinzufügen" />
                                            <Button
                                                Style="{StaticResource DangerButton}"
                                                x:Name="btnRemoveMailboxPermission"
                                                Width="180"
                                                Height="30"
                                                Content="Entfernen" />
                                        </StackPanel>

                                        <!--  SendAs Berechtigungen  -->
                                        <TextBlock FontWeight="SemiBold" Text="SendAs:" />
                                        <StackPanel Margin="0,5,0,15" Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource SuccessButton}"
                                                x:Name="btnAddSendAs"
                                                Width="180"
                                                Height="30"
                                                Margin="0,0,10,0"
                                                Content="Hinzufügen" />
                                            <Button
                                                Style="{StaticResource DangerButton}"
                                                x:Name="btnRemoveSendAs"
                                                Width="180"
                                                Height="30"
                                                Content="Entfernen" />
                                        </StackPanel>

                                        <!--  SendOnBehalf Berechtigungen  -->
                                        <TextBlock FontWeight="SemiBold" Text="SendOnBehalf:" />
                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource SuccessButton}"
                                                x:Name="btnAddSendOnBehalf"
                                                Width="180"
                                                Height="30"
                                                Margin="0,0,10,0"
                                                Content="Hinzufügen" />
                                            <Button
                                                Style="{StaticResource DangerButton}"
                                                x:Name="btnRemoveSendOnBehalf"
                                                Width="180"
                                                Height="30"
                                                Content="Entfernen" />
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <!--  Berechtigungen anzeigen  -->
                                <GroupBox
                                    Margin="0,15,0,10"
                                    Background="#ffffff"
                                    Header="Berechtigungen für ein Postfach anzeigen">
                                    <StackPanel Margin="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="120"
                                                Margin="0,5,10,5"
                                                VerticalAlignment="Center"
                                                Text="Postfach:" />
                                            <TextBox
                                                x:Name="txtMailboxShowPermissions"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="0,5,0,10"
                                                ToolTip="Das Postfach, dessen Berechtigungen angezeigt werden sollen." />

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,5,0,10"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Style="{StaticResource SecondaryButton}"
                                                    x:Name="btnShowMailboxPermissions"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Padding="10,0"
                                                    Content="FullAccess anzeigen" />
                                                <Button
                                                    Style="{StaticResource SecondaryButton}"
                                                    x:Name="btnShowSendAs"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Padding="10,0"
                                                    Content="SendAs anzeigen" />
                                                <Button
                                                    Style="{StaticResource SecondaryButton}"
                                                    x:Name="btnShowSendOnBehalf"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Content="SendOnBehalf anzeigen" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!--  Rechte Spalte - Ausgaben  -->
                            <GroupBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Background="#ffffff"
                                Header="Aktuelle Berechtigungen für das angezeigte Postfach">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
